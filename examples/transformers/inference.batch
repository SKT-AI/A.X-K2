#!/bin/bash
#SBATCH --job-name=axk2-infer
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=32
#SBATCH --mem=400G
#SBATCH --time=03:00:00
#SBATCH --output=%x-%j.out

# A.X K2 FP8 inference on a single node.
#
# `device_map="auto"` shards the model across the GPUs visible to this job, so
# there is no torchrun / distributed launch involved -- one process is enough.
# This is therefore a single-node recipe: the whole 647 GiB FP8 checkpoint must fit
# in one node's aggregate GPU memory. The 4-GPU request below assumes 275GB cards
# (B300); adjust --gres for your hardware and see README.md for sizing.

set -euo pipefail

# ===== user settings =====
export VENV="<YOUR_VENV_PATH>"
MODEL_ID_OR_PATH="skt/A.X-K2"
PROMPT="MoE에 대해서 설명해 주세요"
MAX_NEW_TOKENS=1024
# =========================

source "${VENV}/bin/activate"

export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_ALLOC_CONF=expandable_segments:True

# The FP8 kernel is resolved through the Hub, so this node needs outbound access.
# Setting HF_HUB_OFFLINE=1 is not sufficient even with a warm cache -- see the
# air-gapped recipe in README.md.

nvidia-smi --query-gpu=index,name,memory.total --format=csv

python inference.py \
    --model_dir "${MODEL_ID_OR_PATH}" \
    --prompt "${PROMPT}" \
    --max_new_tokens "${MAX_NEW_TOKENS}"
